# ══════════════════════════════════════════════════════
#  GitHub AI Agent — Configuration Template
#  Copy this file to .env and fill in the values
# ══════════════════════════════════════════════════════

# ── GitHub Personal Access Token ──
# Required scopes: repo, read:discussion, write:discussion
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=github-agents

# ── LLM Provider (swappable) ──
# Default: ollama (local, qwen3-coder). Options: groq | ollama | huggingface
# To use the cloud provider, set LLM_PROVIDER=groq and provide GROQ_API_KEY.
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=ollama
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.3

# ── Groq (OpenAI-compatible, free tier) ──
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── HuggingFace (optional) ──
# HF_API_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ── Ollama (local AI — default provider) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b

# ── Target Languages (comma-separated) ──
# Python is weighted highest; the others are also scanned.
# TARGET_LANGUAGES=["Python","JavaScript","TypeScript","Go","Rust"]
# PRIMARY_LANGUAGE=Python

# ── Loop Settings ──
# LOOP_INTERVAL_SECONDS=3600
# TRENDING_DAYS_AGO=7
# TRENDING_LIMIT_PER_LANGUAGE=5
# MIN_STARS_THRESHOLD=50

# ── Agentic Solver (Phase 5) ──
# How many times to retry, feeding logs + diff back to the model on failed verification.
# SOLVER_MAX_ITERATIONS=3

# ── Trend / Social Signal Aggregator ──
# All sources are free + keyless (GitHub reuses the existing token).
# TREND_SOURCES=["github_search","github_stars","hackernews","reddit"]
# TREND_REDDIT_SUBS=["programming","Python","webdev"]
# Source weights (JSON); determines the combined 0-100 trend score.
# TREND_WEIGHTS={"github_search":0.35,"github_stars":0.30,"hackernews":0.20,"reddit":0.15}

# ── Approval Requirements ──
REQUIRE_APPROVAL_FOR_PR=true
REQUIRE_APPROVAL_FOR_COMMENT=true
